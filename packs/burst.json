{
  "format": "geometry-rhythm-pack",
  "api": 1,
  "id": "burst",
  "name": "Взрыв",
  "description": "Вспышка, расходящееся кольцо и россыпь искр. Хорошо для удара по ноте.",
  "dur": 700,
  "params": [
    {"id": "size", "name": "Размер, px", "min": 40, "max": 200, "step": 10, "default": 110}
  ],
  "layers": [
    {"kind": "flash", "start": 0, "end": 0.3, "radius": "$size", "alpha": [220, 0], "colour": "#ffffff"},
    {"kind": "ring", "start": 0, "end": 0.8, "radius": [0, "$size"], "width": [8, 2], "alpha": [255, 0], "colour": "$colour"},
    {"kind": "particles", "start": 0, "end": 1, "count": 18, "speed": [120, 360], "size": [2, 4], "gravity": 300, "spread": 360, "alpha": [255, 0], "colour": "$colour"}
  ]
}
