{
  "format": "geometry-rhythm-pack",
  "api": 1,
  "id": "my_pack",
  "name": "Мой пакет",
  "description": "Образец для своего пакета. Файлы, начинающиеся с «_», игра не загружает: копируйте этот файл в data/packs/ и меняйте id.",
  "dur": 800,
  "params": [
    {"id": "size", "name": "Радиус, px", "min": 40, "max": 200, "step": 10, "default": 100}
  ],
  "layers": [
    {"kind": "flash", "start": 0, "end": 0.25, "radius": "$size", "alpha": [200, 0], "colour": "#ffffff"},
    {"kind": "ring", "start": 0, "end": 0.9, "radius": [0, "$size"], "width": 6, "alpha": [255, 0], "colour": "$colour"},
    {"kind": "particles", "start": 0, "end": 1, "count": 12, "speed": [100, 260], "size": [2, 4], "gravity": 200, "spread": 360, "trail": false, "length": 0, "alpha": [255, 0], "colour": "$colour"}
  ]
}
